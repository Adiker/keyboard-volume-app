# Maintainer: Adiker <https://github.com/Adiker>
# Stable/release PKGBUILD used for GitHub Release .pkg.tar.zst assets.
# AUR tracking package remains PKGBUILD (keyboard-volume-app-git).
pkgname=keyboard-volume-app
pkgver=0.2.0
pkgrel=1
pkgdesc="Per-app volume control via keyboard with OSD overlay (Qt6)"
arch=('x86_64')
url="https://github.com/Adiker/keyboard-volume-app"
license=('GPL-2.0-or-later')
depends=('qt6-base' 'libevdev' 'libpulse' 'libpipewire' 'taglib' 'pipewire' 'layer-shell-qt')
makedepends=('cmake' 'gcc' 'pkg-config' 'wayland' 'layer-shell-qt')
conflicts=('keyboard-volume-app-git')
provides=('keyboard-volume-app')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -S "${pkgname}-${pkgver}/cpp" -B build \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=OFF
    cmake --build build -j"$(nproc)"
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
}
